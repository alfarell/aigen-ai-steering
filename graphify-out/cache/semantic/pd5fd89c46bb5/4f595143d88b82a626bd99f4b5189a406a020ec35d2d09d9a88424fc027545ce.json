{"nodes": [{"id": "aigen_backend_docs_duplicate_pr_rfq_root_cause_summary_duplicate_rfq_root_cause", "label": "Duplicate PR to RFQ Root Cause", "file_type": "rationale", "rationale": "The RFQ-creation job had no safeguard against re-processing the same PR item, so overlapping or repeated cron executions minted a second independent set of RFQ numbers for records that already existed.", "source_file": "aigen-backend/docs/duplicate-pr-rfq-root-cause-summary.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "aigen_backend_docs_duplicate_pr_rfq_root_cause_summary_sync_rfq_job", "label": "sync_rfq Scheduled Job", "file_type": "rationale", "source_file": "aigen-backend/docs/duplicate-pr-rfq-root-cause-summary.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "aigen_backend_docs_duplicate_pr_rfq_root_cause_summary_unique_constraint_fix", "label": "PR Item Vendor Uniqueness Guard", "file_type": "rationale", "rationale": "An existence check plus a database-level uniqueness rule on PR number, item code and vendor code makes recurrence impossible regardless of how often the cron overlaps.", "source_file": "aigen-backend/docs/duplicate-pr-rfq-root-cause-summary.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "aigen_backend_docs_duplicate_pr_rfq_root_cause_summary_legacy_duplicate_cleanup", "label": "Legacy Duplicate Cleanup Decision", "file_type": "rationale", "rationale": "Both sides of most duplicate pairs already carry tokens, uploads or a QCF, so choosing the surviving RFQ number is a business decision and cannot be scripted.", "source_file": "aigen-backend/docs/duplicate-pr-rfq-root-cause-summary.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "aigen_backend_docs_duplicate_pr_rfq_root_cause_summa