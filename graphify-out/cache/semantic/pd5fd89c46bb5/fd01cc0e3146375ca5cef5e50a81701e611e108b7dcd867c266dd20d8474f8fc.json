{"nodes": [{"id": "aigen_backend_docs_manual_sourcing_manual_sourcing_flow_manual_sourcing_flow", "label": "Manual Sourcing Flow (CS & Admin)", "file_type": "document", "source_file": "aigen-backend/docs/manual-sourcing/manual-sourcing-flow.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "aigen_backend_docs_manual_sourcing_manual_sourcing_flow_sendactiontocs", "label": "sendActionToCS", "file_type": "concept", "source_file": "aigen-backend/docs/manual-sourcing/manual-sourcing-flow.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "aigen_backend_docs_manual_sourcing_manual_sourcing_flow_prosestoisourcing", "label": "prosesToIsourcing", "file_type": "concept", "rationale": "iSourcing uses a Kanban model: each PR becomes a board card that moves between lists, with PR items stored as item_card rows. If the card already exists only new items are appended, so re-running never duplicates a card.", "source_file": "aigen-backend/docs/manual-sourcing/manual-sourcing-flow.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "aigen_backend_docs_manual_sourcing_manual_sourcing_flow_bulkupdatestatusrfq", "label": "bulkUpdateStatusRFQ", "file_type": "concept", "rationale": "Updates rfq_library and qcf_library in one transaction with Promise.all, so a partial failure rolls both back; the milestone written depends on status_vendor (null yields MANUAL_SOURCING_FAILED, ACCEPTED yields ISOURCING, otherwise BID_MANUAL_SOURCING).", "source_file": "aigen-backend/docs/manual-sourcing/manual-sourcing-flow.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "aigen_backend_docs_manual_sourcing_manual_sourcing_flow_configreason_getlist", "label": "configReasonController.getList", "file_type": "concept", "source_file": "aigen-backend/docs/manual-sourcing/manual-sourcing-flow.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "aigen_backend_docs_manual_sourcing_manual_sourcing_flow_getlistbyroleid", "label": "getListByRoleId", "file_type": "concept", "rationale": "Reasons are filtered by role_id because CS and Admin have different valid justifications for diverting an item, so each role only sees the options relevant to it.", "source_file": "aigen-backend/docs/manual-sourcing/manual-sourcing-flow.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "aigen_backend_docs_manual_sourcing_manual_sourcing_flow_vendor2_eligibility", "label": "Vendor 2 Eligibility Validation (CS vs Admin)", "file_type": "rationale", "rationale": "If Vendor 1 already accepted an item, Vendor 2 must not be diverted for it. CS may only push Vendor 2 items when Vendor 1 declined, or when the reminder date has passed and Vendor 1 is still pending. Admin bypasses the check entirely and pulls Vendor 1 items in alongside, because Admin may move a whole RFQ at once.", "source_file": "aigen-backend/docs/manual-sourcing/manual-sourcing-flow.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "aigen_backend_docs_manual_sourcing_manual_sourcing_flow_config_reason", "label": "config_reason table", "file_type": "concept", "source_file": "aigen-backend/docs/manual-sourcing/manual-sourcing-flow.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "aigen_backend_docs_manual_sourcing_manual_sourcing_flow_deactivatetokensbyrfqbatch", "label": "deactivateTokensByRfqBatch", "file_type": "concept", "source_file": "aigen-backend/docs/manual-sourcing/manual-sourcing-flow.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "aigen_backend_docs_manual_sourcing_manual_sourcing_flow_deactivatetokensbyrfqnumber", "label": "deactivateTokensByRfqNumber", "file_type": "concept", "source_file": "aigen-backend/docs/manual-sourcing/manual-sourcing-flow.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "aigen_backend_docs_manual_sourcing_manual_sourcing_flow_token_deactivation", "label": "Post-iSourcing Token Deactivation", "file_type": "rationale", "rationale": "Once items enter iSourcing the vendor no longer needs the quotation page, so vendor and QCF tokens are deactivated to make already-sent email links unusable.", "source_file": "aigen-backend/docs/manual-sourcing/manual-sourcing-flow.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "aigen_backend_docs_manual_sourcing_manual_sourcing_flow_addlogquotationbydataitems", "label": "addLogQuotationByDataItems", "file_type": "concept", "source_file": "aigen-backend/docs/manual-sourcing/manual-sourcing-flow.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "aigen_backend_docs_manual_sourcing_manual_sourcing_flow_getdistinctvendorsbyrfq", "label": "getDistinctVendorsByRfq", "file_type": "concept", "source_file": "aigen-backend/docs/manual-sourcing/manual-sourcing-flow.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "aigen_backend_docs_manual_sourcing_manual_sourcing_flow_getrfqwithvendormatriks", "label": "getRfqWithVendorMatriks", "file_type": "concept", "source_file": "aigen-backend/docs/manual-sourcing/manual-sourcing-flow.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "aigen_backend_docs_manual_sourcing_manual_sourcing_flow_rfq_library", "label": "rfq_library table", "file_type": "concept", "source_file": "aigen-backend/docs/manu