": "DIC reset (status_dic / dic_batch nulled) on resend", "file_type": "rationale", "rationale": "Resending an RFQ restarts the process, so any earlier DIC review is void: status_dic and dic_batch are set to null and DIC must review again once the vendor submits a new quotation.", "source_file": "aigen-backend/docs/resend-rfq/resend-rfq-vendor.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "aigen_backend_docs_resend_rfq_resend_rfq_vendor_config_auto_po_sla", "label": "config_auto_po WAITING_VENDOR_EXPIRY SLA config", "file_type": "concept", "source_file": "aigen-backend/docs/resend-rfq/resend-rfq-vendor.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "aigen_backend_docs_resend_rfq_resend_rfq_vendor_calculate_submission_deadline_and_sla", "label": "calculateSubmissionDeadlineAndSla() business-day helper", "file_type": "code", "source_file": "aigen-backend/docs/resend-rfq/resend-rfq-vendor.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "aigen_backend_docs_resend_rfq_resend_rfq_vendor_handle_send_template_email", "label": "handleSendTemplateEmail() generic email handler", "file_type": "code", "source_file": "aigen-backend/docs/resend-rfq/resend-rfq-vendor.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "aigen_backend_docs_resend_rfq_resend_rfq_vendor_failed_emails_table", "label": "failed_emails table (email retry store)", "file_type": "concept", "source_file": "aigen-backend/docs/resend-rfq/resend-rfq-vendor.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "aigen_backend_docs_resend_rfq_resend_rfq_vendor_log_quotation_table", "label": "log_quotation milestone logging (RESEND_RFQ 7, RFQ_SENT_TO_VENDOR 4)", "file_type": "concept", "sou