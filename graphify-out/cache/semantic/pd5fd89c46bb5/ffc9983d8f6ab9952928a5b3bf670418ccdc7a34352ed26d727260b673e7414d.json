{"nodes": [{"id": "aigen_backend_claude_repository_service_controller_pattern", "label": "Repository-Service-Controller Pattern", "file_type": "rationale", "rationale": "Repositories abstract all Sequelize queries so business logic in services and HTTP logic in controllers stay free of raw data access.", "source_file": "aigen-backend/CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "aigen_backend_claude_three_database_architecture", "label": "Three-Database Sequelize Architecture", "file_type": "rationale", "rationale": "Primary aigen_db, iSourcing task_board and the SAP prpo search library are separate systems of record, so each gets its own connection, model directory and migration tree.", "source_file": "aigen-backend/CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "aigen_backend_claude_dual_authentication", "label": "Dual Authentication Dashboard JWT vs Email Token", "file_type": "rationale", "rationale": "Vendors have no dashboard account, so identity travels in a JWT embedded in an email link and is validated against rfqTokenEmail rather than a session.", "source_file": "aigen-backend/CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "aigen_backend_claude_business_day_calculation", "label": "Business Day SLA Calculation", "file_type": "rationale", "rationale": "Token expiry and SLA tracking use business days rather than calendar days so weekends do not consume a vendor response window.", "source_file": "aigen-backend/CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "aigen_backend_claude_email_notification_system", "label": "Email Notification Template System", "file_type": "rationale", "source_file": "aigen-backend/CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "aigen_backend_claude_cron_job_architecture", "label": "Cron Job Architecture", "file_type": "rationale", "rationale": "Every cron reminder is also exposed as a manual API endpoint so a single workflow can be re-triggered without waiting for the schedule.", "source_file": "aigen-backend/CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "aigen_backend_claude_sendresponse_convention", "label": "sendResponse Response Convention", "file_type": "rationale", "source_file": "aigen-backend/CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "aigen_backend_claude_route_async_wrapper", "label": "routeAsyncWrapper Error Handling", "file_type": "rationale", "source_file": "aigen-backend/CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "aigen_backend_claude_file_upload_handling", "label": "Three-Type File Upload Handling", "file_type": "rationale", "source_file": "aigen-backend/CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "aigen_backend_claude_config_joi_validation", "label": "Centralized Joi-Validated Configuration", "file_type": "rationale", "rationale": "All environment variables pass one Joi schema in config.js so a malformed value fails at boot instead of at first use.", "source_file": "aigen-backend/CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "aigen_backend_claude_git_operations_policy", "label": "No Autonomous Git Operations Policy", "file_type": "rationale", "rationale": "Users need full control over version control; autonomous commits can create unwanted history or push incomplete work.", "source_file": "aigen-backend/CLAUDE.md", "sour