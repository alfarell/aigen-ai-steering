{"nodes": [{"id": "aigen_backend__claude_changelog_isourcing_transfer_driver_layer", "label": "iSourcing Transfer Driver Layer", "file_type": "rationale", "rationale": "Transfers to iSourcing run behind a driver selected by one environment value so the existing direct-database mechanism stays the default while an API driver is developed; cutover becomes a config change rather than a code change.", "source_file": "aigen-backend/.claude/CHANGELOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "aigen_backend__claude_changelog_isourcing_transfer_port", "label": "isourcingTransfer.port", "file_type": "rationale", "rationale": "A single route into iSourcing that validates input, resolves the driver, guards the result shape, emits one structured log line per transfer and tags Sentry on failure, so no caller can bypass those invariants.", "source_file": "aigen-backend/.claude/CHANGELOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "aigen_backend__claude_changelog_api_driver", "label": "iSourcing api.driver", "file_type": "rationale", "rationale": "Conforms to iSourcing API contract v1.0: pr_library plus pr_items payload, Idempotency-Key header, payload size guard, and a retry classifier that retries only network, timeout and 503 KAFKA_UNAVAILABLE.", "source_file": "aigen-backend/.claude/CHANGELOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "aigen_backend__claude_changelog_database_driver", "label": "iSourcing database.driver", "file_type": "rationale", "rationale": "The pre-existing transfer logic moved verbatim out of qcfController so the default path is provably unchanged.", "source_file": "aigen-backend/.claude/CHANGELOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "aigen_backend__claude_changelog_isourcing_reconciliation_service", "label": "isourcingReconciliation.service", "file_type": "rationale", "rationale": "The API contract is a synchronous gate over asynchronous execution, so a transfer cannot report a final result in one call; a reconcile stage polls status, performs the deferred Aigen work on success, re-sends transient failures with a fresh idempotency key and escalates stale rows.", "source_file": "aigen-backend/.claude/CHANGELOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "aigen_backend__claude_changelog_pending_transfer_outcome", "label": "Pending Transfer Outcome", "file_type": "rationale", "rationale": "A third outcome beyond success and failure: while a transfer is only queued the RFQ token stays active and Aigen state is untouched, so nothing is committed against an unconfirmed transfer.", "source_file": "aigen-backend/.claude/CHANGELOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "aigen_backend__claude_changelog_isourcing_transfer_requests_table", "label": "isourcing_transfer_requests Table", "file_type": "rationale", "rationale": "Stores business_key, origin_stage and an exhausted status so the attempt count is derived from stored state rather than defaulting to zero, which previously let a failed transfer block its PR forever.", "source_file": "aigen-backend/.claude/CHANGELOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "aigen_backend__claude_changelog_cl_approval_approval_config_fix", "label": "CL Approval Follows approval_config", "file_type": "rationale", "rationale": "approveByCL branched on a feature flag before approvalConfig was consulted, so a flag silently cancelled Auto PO for QCFs whose stored config made CL approval final; every CL approval now flows through bulkApproveByCL which derives needsManagementApproval from the config.", "source_file": "aigen-backend/.claude/CHANGELOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "aigen_backend__claude_changelog_gems_manual_po_flow_flag", "label": "GEMS_MANUAL_PO_FLOW Feature Flag", "file_type": "rationale", "rationale": "A pilot flag left active in production overrode stored configuration; the lesson recorded is that a feature flag must not be able to cancel a result already determined by configuration.", "source_file": "aigen-backend/.claude/CHANGELOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "aigen_backend__claude_changelog_milestone_26_waiting_manual_po", "label": "Milestone 26 Waiting Manual PO", "file_type": "rationale", "rationale": "Milestone 26 has no forward exit and bulkApproveByClForManualPo never calls syncAutoPO, so parked QCFs cannot self-heal and a retry is rejected as ALREADY_APPROVED.", "source_file": "aigen-backend/.claude/CHANGELOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "aigen_backend__claude_changelog_awaits_management_approval", "label": "awaitsManagementApproval Predicate", "file_type": "rationale", "rationale": "WAITING_MANAGEMENT was inferred from cl_approved_at alone in four places, labelling CL-final configs with a stage that does not exist; one JS and one SQL definition now both require approval_config to contain management, with COALESCE so a NULL config never drops a row out of both filters.", "source_file": "aigen-backend/.claude/CHANGELOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "aigen_backend__claude_changelog_dic_reminder_known_issue_baseline", "label": "DIC Reminder Failing-Suite Baseline", "file_type": "rationale", "rationale": "qcfController.dicReminder and rfqLibrary.dicReminder fail identically before and after each change, so they are treated as a recorded known-issue baseline rather than a regression signal.", "source_file": "aigen-backend/.claude/CHANGELOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "aigen_backend__claude_changelog_production_deployment_topology", "label": "Production Deployment Topology Correction", "file_type": "rationale", "rationale": "Production is a GCE VM running docker compose, not the Docker Swarm stack in deploy/develop.yaml, and there is no production deploy job in .gitlab-ci.yml.", "source_file": "aigen-backend/.claude/CHANGELOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "aigen_backend__claude_changelog_production_deployment_topology", "target": "aigen_backend_deploy_develop_playbook", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "aigen-backend/.claude/CHANGELOG.md", "source_location": null, "weight": 1.0}, {"source": "aigen_backend__claude_changelog_production_deployment_topology", "target": "aigen_backend__gitlab_ci_pipeline", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "aigen-backend/.claude/CHANGELOG.md", "source_location": null, "weight": 1.0}, {"source": "aigen_backend__claude_changelog_isourcing_transfer_driver_layer", "target": "aigen_backend__claude_changelog_isourcing_transfer_port", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "aigen-backend/.claude/CHANGELOG.md", "source_location": null, "weight": 1.0}, {"source": "aigen_backend__claude_changelog_isourcing_transfer_port", "target": "aigen_backend__claude_changelog_api_driver", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "aigen-backend/.claude/CHANGELOG.md", "source_location": null, "weight": 1.0}, {"source": "aigen_backend_