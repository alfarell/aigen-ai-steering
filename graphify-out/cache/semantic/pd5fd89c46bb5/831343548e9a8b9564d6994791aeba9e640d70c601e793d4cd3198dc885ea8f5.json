{"nodes": [{"id": "aigen_backend_docs_approve_trigger_po_eksekusi_untuk_ba_id_fix_001", "label": "FIX-001 GEMS Auto PO Recovery Plan", "file_type": "document", "source_file": "aigen-backend/docs/APPROVE-TRIGGER-PO-eksekusi-untuk-BA.id.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "aigen_backend_docs_approve_trigger_po_eksekusi_untuk_ba_id_risiko_po_ganda", "label": "Duplicate PO Risk", "file_type": "rationale", "rationale": "Parking a QCF at Waiting Manual PO emails CS a live link instructing a manual SAP PO; re-approving such a QCF would create a second PO for the same purchase, and cancellation is only possible inside SAP.", "source_file": "aigen-backend/docs/APPROVE-TRIGGER-PO-eksekusi-untuk-BA.id.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "aigen_backend_docs_approve_trigger_po_eksekusi_untuk_ba_id_langkah_4_rewind", "label": "Step 4 QCF Status Rewind", "file_type": "rationale", "rationale": "Rewind runs one QCF at a time inside a transaction with a guard clause and only against QCFs CS has cleared as having no manual PO; a verified table backup is a hard precondition because this writes production data.", "source_file": "aigen-backend/docs/APPROVE-TRIGGER-PO-eksekusi-untuk-BA.id.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "aigen_backend_docs_approve_trigger_po_eksekusi_untuk_ba_id_langkah_5_reapproval", "label": "Step 5 CL Re-Approval", "file_type": "rationale", "rationale": "The point of no return: re-approval issues a real SAP PO, which AIGEN cannot cancel; it also requires the rewind first because the system rejects a repeat approval with ALREADY_APPROVED.", "source_file": "aigen-backend/docs/APPROVE-TRIGGER-PO-eksekusi-untuk-BA.id.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "aigen_backend_docs_approve_trigger_po_eksekusi_untuk_ba_id_k1_konfirmasi_po_manual", "label": "K-1 CS Manual PO Confirmation", "file_type": "rationale", "rationale": "A per-QCF business confirmation, not a technical check: the scheduled SAP sync has been dead since 13 January 2026, so any existing PO can only have come from a manual CS action, making the CS answer the sole determinant of safety.", "source_file": "aigen-backend/docs/APPROVE-TRIGGER-PO-eksekusi-untuk-BA.id.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "aigen_backend_docs_approve_trigger_po_eksekusi_untuk_ba_id_k6_metode_approve_ulang", "label": "K-6 Re-Approval Method Decision", "file_type": "rationale", "rationale": "CL clicking in the app versus IT scripting the API against an admin token; bulkApproveByCL never writes cl_id, so the acting identity survives only in logActivity, which is why the choice is a business decision.", "source_file": "aigen-backend/docs/APPROVE-TRIGGER-PO-eksekusi-untuk-BA.id.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "aigen_backend_docs_approve_trigger_po_eksekusi_untuk_ba_id_fix_001", "target": "aigen_backend_docs_approve_trigger_po_eksekusi_untuk_ba_id_risiko_po_ganda", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "aigen-backend/docs/APPROVE-TRIGGER-PO-eksekusi-untuk-BA.id.md", "source_location": null, "weight": 1.0}, {"source": "aigen_backend_docs_approve_trigger_po_eksekusi_untuk_ba_id_risiko_po_ganda", "target": "aigen_backend_docs_approve_trigger_po_eksekusi_untuk_ba_id_k1_konfirmasi_po_manual", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "aigen-backend/docs/APPROVE-TRIGGER-PO-eksekusi-untuk-BA.id.md", "source_location": null, "weight": 1.0}, {"source": "aigen_backend_docs_approve_trigger_po_eksekusi_untuk_ba_id_k1_k