{"nodes": [{"id": "aigen_backend_docs_feature_rfq_reminder_flow_analysis_rfq_reminder_flow_analysis", "label": "RFQ Reminder Flow Analysis (H+3, H+6, H+9)", "file_type": "document", "source_file": "aigen-backend/docs/feature/rfq-reminder-flow-analysis.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "aigen_backend_docs_feature_rfq_reminder_flow_analysis_h3_reminder", "label": "H+3 Reminder (sendThreeDayPendingRfqReminders)", "file_type": "concept", "source_file": "aigen-backend/docs/feature/rfq-reminder-flow-analysis.md", "source_location": "Day 3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Activates a Level 2 vendor at H+3 when only Level 1 exists, so competition is introduced before the deadline rather than after a failure."}, {"id": "aigen_backend_docs_feature_rfq_reminder_flow_analysis_h6_reminder", "label": "H+6 Reminder (sendSixDayPendingRfqReminders)", "file_type": "concept", "source_file": "aigen-backend/docs/feature/rfq-reminder-flow-analysis.md", "source_location": "Day 6", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Escalates visibility to CS (milestone 22 for vendor 1, 5 for vendor 2) instead of acting automatically, giving a human the chance to intervene before auto-escalation."}, {"id": "aigen_backend_docs_feature_rfq_reminder_flow_analysis_h9_auto_isourcing", "label": "H+9 Auto iSourcing (handleNineDayRfqFollowUp)", "file_type": "concept", "source_file": "aigen-backend/docs/feature/rfq-reminder-flow-analysis.md", "source_location": "Day 9", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only fires when exactly two vendors exist and both are still pending, so RFQs with any vendor response are never auto-diverted to manual procurement."}, {"id": "aigen_backend_docs_feature_rfq_reminder_flow_analysis_business_day_token_expiry", "label": "Business-day token expiry consistency", "file_type": "rationale", "source_file": "aigen-backend/docs/feature/rfq-reminder-flow-analysis.md", "source_location": "Token Expiry Consistency", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Calendar-day expiry gave vendors and DIC fewer working days when a deadline spanned a weekend; addBusinessDays/subtractBusinessDays is now used for RFQ queries, token expiry and email deadlines alike so all three agree."}, {"id": "aigen_backend_docs_feature_rfq_reminder_flow_analysis_progressive_escalation", "label": "Progressive escalation reminder mechanism", "file_type": "rationale", "source_file": "aigen-backend/docs/feature/rfq-reminder-flow-analysis.md", "source_location": "Summary", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Gentle reminder, then CS alert, then automatic escalation: each stage raises cost only after the cheaper one has failed, avoiding both premature manual work and indefinitely stalled RFQs."}], "edges": [{"source": "aigen_backend_docs_feature_rfq_reminder_flow_analysis_rfq_reminder_flow_analysis", "target": "aigen_backend_docs_feature_rfq_reminder_flow_analysis_h3_reminder", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "aigen-backend/docs/feature/rfq-reminder-flow-analysis.md", "source_location": "Day 3", "weight": 1.0}, {"source": "aigen_backend_docs_feature_rfq_reminder_flow_analysis_rfq_reminder_flow_analysis", "target": "aigen_backend_docs_feature_rfq_reminder_flow_analysis_h6_reminder", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "aigen-backend/docs/feature/rfq-reminder-flow-analysis.md", "source_location": "Day 6", "weight": 1.0}, {"source": "aigen_backend_docs_feature_rfq_reminder_flow_analysis_rfq_reminder_flow_analysis", "target": "aigen_backend_docs_feature_rfq_reminder_flow_analysis_h9_auto_isourcing", "relation": "refere